@page "/"
@using RetirementCalculator.Domain.Models
@rendermode InteractiveServer

<PageTitle>Retirement planning calculator</PageTitle>

<h1>Retirement planning calculator</h1>

<p class="disclaimer" role="note">
    This tool gives a rough <strong>estimate only</strong> based on simplified assumptions and a
    modeled inflation path. It is <strong>not financial, tax, or legal advice</strong> and should
    be used alongside a careful review of your actual retirement plan.
</p>

<form class="ss-form" @onsubmit="Calculate">
    <div class="ss-form-grid">
        <div class="ss-field">
            <label for="birthYear">Birth year</label>
            <input id="birthYear" type="number" class="form-control" inputmode="numeric"
                   aria-describedby="birthYear-error"
                   aria-invalid="@(ErrorFor(nameof(SocialSecurityCalculatorInput.BirthYear)) is not null)"
                   @bind="_input.BirthYear" @bind:event="oninput" />
            @if (ErrorFor(nameof(SocialSecurityCalculatorInput.BirthYear)) is { } birthYearError)
            {
                <div id="birthYear-error" class="field-error" role="alert">@birthYearError</div>
            }
        </div>

        <div class="ss-field">
            <label for="fraBenefit">Monthly benefit at full retirement age ($)</label>
            <input id="fraBenefit" type="number" step="0.01" min="0" class="form-control" inputmode="decimal"
                   aria-describedby="fraBenefit-error fraBenefit-hint"
                   aria-invalid="@(ErrorFor(nameof(SocialSecurityCalculatorInput.MonthlyBenefitAtFullRetirementAge)) is not null)"
                   @bind="_input.MonthlyBenefitAtFullRetirementAge" @bind:event="oninput" />
            <a id="fraBenefit-hint" class="ssa-link" href="https://www.ssa.gov/myaccount/"
               target="_blank" rel="noopener noreferrer">
                Find your estimate at my Social Security account
            </a>
            @if (ErrorFor(nameof(SocialSecurityCalculatorInput.MonthlyBenefitAtFullRetirementAge)) is { } fraBenefitError)
            {
                <div id="fraBenefit-error" class="field-error" role="alert">@fraBenefitError</div>
            }
        </div>

        <div class="ss-field">
            <label for="initialBalance">Initial account balance ($)</label>
            <input id="initialBalance" type="number" step="0.01" min="0" class="form-control" inputmode="decimal"
                   aria-describedby="initialBalance-error"
                   aria-invalid="@(ErrorFor(nameof(SocialSecurityCalculatorInput.InitialAccountBalance)) is not null)"
                   @bind="_input.InitialAccountBalance" @bind:event="oninput" />
            @if (ErrorFor(nameof(SocialSecurityCalculatorInput.InitialAccountBalance)) is { } initialBalanceError)
            {
                <div id="initialBalance-error" class="field-error" role="alert">@initialBalanceError</div>
            }
        </div>

        <div class="ss-field">
            <label for="monthlySpending">Monthly spending in today's dollars ($)</label>
            <input id="monthlySpending" type="number" step="0.01" min="0" class="form-control" inputmode="decimal"
                   aria-describedby="monthlySpending-error"
                   aria-invalid="@(ErrorFor(nameof(SocialSecurityCalculatorInput.MonthlySpendingInTodaysDollars)) is not null)"
                   @bind="_input.MonthlySpendingInTodaysDollars" @bind:event="oninput" />
            @if (ErrorFor(nameof(SocialSecurityCalculatorInput.MonthlySpendingInTodaysDollars)) is { } monthlySpendingError)
            {
                <div id="monthlySpending-error" class="field-error" role="alert">@monthlySpendingError</div>
            }
        </div>

        <div class="ss-field">
            <label for="averageInflationRate">Average inflation rate (%)</label>
            <input id="averageInflationRate" type="number" step="0.1" min="0" max="12" class="form-control" inputmode="decimal"
                   aria-describedby="averageInflationRate-error"
                   aria-invalid="@(ErrorFor(nameof(SocialSecurityCalculatorInput.AverageInflationRate)) is not null)"
                   @bind="_input.AverageInflationRate" @bind:event="oninput" />
            @if (ErrorFor(nameof(SocialSecurityCalculatorInput.AverageInflationRate)) is { } averageInflationRateError)
            {
                <div id="averageInflationRate-error" class="field-error" role="alert">@averageInflationRateError</div>
            }
        </div>

        <fieldset class="ss-field">
            <legend>Retirement age</legend>
            <div class="ss-age-inputs">
                <label for="retirementAgeYears">Years
                    <input id="retirementAgeYears" type="number" min="0" class="form-control" inputmode="numeric"
                           aria-describedby="retirementAge-error"
                           aria-invalid="@(ErrorFor(nameof(SocialSecurityCalculatorInput.RetirementAgeYears)) is not null)"
                           @bind="_input.RetirementAgeYears" @bind:event="oninput" />
                </label>
                <label for="retirementAgeMonths">Months
                    <input id="retirementAgeMonths" type="number" min="0" max="11" class="form-control" inputmode="numeric"
                           aria-describedby="retirementAge-error"
                           @bind="_input.RetirementAgeMonths" @bind:event="oninput" />
                </label>
            </div>
            @if (ErrorFor(nameof(SocialSecurityCalculatorInput.RetirementAgeYears)) is { } retirementAgeError)
            {
                <div id="retirementAge-error" class="field-error" role="alert">@retirementAgeError</div>
            }
        </fieldset>

        <fieldset class="ss-field">
            <legend>Claim age (62 through your full retirement age)</legend>
            <div class="ss-age-inputs">
                <label for="claimAgeYears">Years
                    <input id="claimAgeYears" type="number" min="0" class="form-control" inputmode="numeric"
                           aria-describedby="claimAge-error"
                           aria-invalid="@(ErrorFor(nameof(SocialSecurityCalculatorInput.ClaimAgeYears)) is not null)"
                           @bind="_input.ClaimAgeYears" @bind:event="oninput" />
                </label>
                <label for="claimAgeMonths">Months
                    <input id="claimAgeMonths" type="number" min="0" max="11" class="form-control" inputmode="numeric"
                           aria-describedby="claimAge-error"
                           @bind="_input.ClaimAgeMonths" @bind:event="oninput" />
                </label>
            </div>
            @if (ErrorFor(nameof(SocialSecurityCalculatorInput.ClaimAgeYears)) is { } claimAgeError)
            {
                <div id="claimAge-error" class="field-error" role="alert">@claimAgeError</div>
            }
        </fieldset>

        <fieldset class="ss-field">
            <legend>Planning age (through what age to project totals)</legend>
            <div class="ss-age-inputs">
                <label for="planningAgeYears">Years
                    <input id="planningAgeYears" type="number" min="0" class="form-control" inputmode="numeric"
                           aria-describedby="planningAge-error"
                           aria-invalid="@(ErrorFor(nameof(SocialSecurityCalculatorInput.PlanningAgeYears)) is not null)"
                           @bind="_input.PlanningAgeYears" @bind:event="oninput" />
                </label>
                <label for="planningAgeMonths">Months
                    <input id="planningAgeMonths" type="number" min="0" max="11" class="form-control" inputmode="numeric"
                           aria-describedby="planningAge-error"
                           @bind="_input.PlanningAgeMonths" @bind:event="oninput" />
                </label>
            </div>
            @if (ErrorFor(nameof(SocialSecurityCalculatorInput.PlanningAgeYears)) is { } planningAgeError)
            {
                <div id="planningAge-error" class="field-error" role="alert">@planningAgeError</div>
            }
        </fieldset>
    </div>

    <button type="submit" class="btn btn-primary">Calculate</button>
</form>

@if (_result is { } result)
{
    var chosenProjection = result.ChosenAgeScenario.RetirementBalanceProjection;
    var fraProjection = result.FullRetirementAgeScenario.RetirementBalanceProjection;
    var firstYearSpending = chosenProjection?.ProjectionSeries.FirstOrDefault().AnnualExpense ?? 0m;
    var firstYearBenefit = chosenProjection?.ProjectionSeries.FirstOrDefault().AnnualSocialSecurityIncome ?? 0m;
    var firstYearNetWithdrawal = chosenProjection?.ProjectionSeries.FirstOrDefault().NetWithdrawal ?? 0m;
    var projectedDepletion = chosenProjection?.FirstDepletionAge is Age chosenDepletion ? chosenDepletion : null;
    var projectedDepletionText = chosenProjection?.FirstDepletionAge is Age firstDepletionAge
        ? $"Projected depletion: Age {firstDepletionAge} ({chosenProjection.FirstDepletionCalendarYear})"
        : fraProjection?.FirstDepletionAge is Age fraDepletionAge
            ? $"Projected depletion: Age {fraDepletionAge} ({fraProjection.FirstDepletionCalendarYear})"
            : null;

    <section class="ss-results" aria-live="polite">
        <h2>Results</h2>
        <p>Your full retirement age (FRA) is <strong>@result.FullRetirementAge</strong>.</p>

        <p class="modeled-cola">
            Modeled COLA: spending and Social Security income follow a shared annual inflation path averaging
            @FormatPercent(result.AverageInflationRate) per year.
        </p>

        @if (projectedDepletionText is { Length: > 0 } depletionNotice)
        {
            <p class="depletion-note">@depletionNotice</p>
        }

        @if (chosenProjection is { IsFirstYearNetWithdrawalAboveFourPercentGuideline: true })
        {
            <div class="withdrawal-warning" role="alert">
                Warning: first-year net withdrawal of @FormatCurrency(firstYearNetWithdrawal) is above the 4% guideline for an initial balance of @FormatCurrency(chosenProjection.InitialAccountBalance).
            </div>
        }

        @if (result.IsChosenAgeSameAsFullRetirementAge)
        {
            <p>
                Your chosen claim age is the same as your full retirement age, so both scenarios below
                are identical and there is no meaningful break-even age.
            </p>
        }

        <div class="ss-results-grid">
            <div class="ss-results-column">
                <div class="ss-table-wrapper">
                    <table class="ss-comparison-table">
                        <caption class="visually-hidden">Side-by-side comparison of claiming at your chosen age versus at full retirement age</caption>
                        <thead>
                            <tr>
                                <th scope="col">&nbsp;</th>
                                <th scope="col">Claim at chosen age</th>
                                <th scope="col">Claim at full retirement age</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row">Age at claim</th>
                                <td>@result.ChosenAgeScenario.ClaimAge</td>
                                <td>@result.FullRetirementAgeScenario.ClaimAge</td>
                            </tr>
                            <tr>
                                <th scope="row">Monthly benefit in first retirement year</th>
                                <td>@FormatCurrency((result.ChosenAgeScenario.RetirementBalanceProjection?.ProjectionSeries.FirstOrDefault().AnnualSocialSecurityIncome ?? 0m) / 12m)</td>
                                <td>@FormatCurrency((result.FullRetirementAgeScenario.RetirementBalanceProjection?.ProjectionSeries.FirstOrDefault().AnnualSocialSecurityIncome ?? 0m) / 12m)</td>
                            </tr>
                            <tr>
                                <th scope="row">Annual benefit in first retirement year</th>
                                <td>@FormatCurrency(result.ChosenAgeScenario.RetirementBalanceProjection?.ProjectionSeries.FirstOrDefault().AnnualSocialSecurityIncome ?? 0m)</td>
                                <td>@FormatCurrency(result.FullRetirementAgeScenario.RetirementBalanceProjection?.ProjectionSeries.FirstOrDefault().AnnualSocialSecurityIncome ?? 0m)</td>
                            </tr>
                            <tr>
                                <th scope="row">Payment months through planning age</th>
                                <td>@result.ChosenAgeScenario.PaymentMonthsThroughPlanningAge</td>
                                <td>@result.FullRetirementAgeScenario.PaymentMonthsThroughPlanningAge</td>
                            </tr>
                            <tr>
                                <th scope="row">Cumulative total through planning age</th>
                                <td>@FormatCurrency(result.ChosenAgeScenario.CumulativeTotalThroughPlanningAge)</td>
                                <td>@FormatCurrency(result.FullRetirementAgeScenario.CumulativeTotalThroughPlanningAge)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <ul class="ss-summary-list">
                    <li>Waiting increase: @FormatCurrency(result.WaitingIncreaseAmount) per month
                        (@FormatPercent(result.WaitingIncreasePercent))</li>
                    <li>
                        Cumulative difference through planning age:
                        @FormatCurrency(result.CumulativeDifferenceAtPlanningAge)
                        (@(result.CumulativeDifferenceAtPlanningAge >= 0 ? "favors waiting for full retirement age" : "favors claiming at your chosen age"))
                    </li>
                    @if (result.BreakEvenAge is { } breakEvenAge)
                    {
                        <li>First break-even age (waiting catches up in total dollars): @breakEvenAge</li>
                    }
                    else if (!result.IsChosenAgeSameAsFullRetirementAge)
                    {
                        <li>No break-even age was found within the calculator's search horizon.</li>
                    }
                </ul>
            </div>

            <div class="ss-results-graph-panel">
                <CumulativeProjectionGraph
                    SelectedSeries="result.ChosenAgeScenario.ProjectionSeries"
                    FraSeries="result.FullRetirementAgeScenario.ProjectionSeries"
                    SelectedSeriesLabel="Claim at chosen age"
                    FraSeriesLabel="Claim at full retirement age" />
            </div>
        </div>

        @if (chosenProjection is { } chosenBalance && fraProjection is { } fraBalance)
        {
            var firstPoint = chosenBalance.ProjectionSeries.FirstOrDefault();
            <div class="balance-results-panel">
                <h3>Account balance projection</h3>
                <div class="balance-summary-grid">
                    <div class="balance-metric">
                        <span>First-year inflated spending</span>
                        <strong>@FormatCurrency(firstPoint.AnnualExpense)</strong>
                    </div>
                    <div class="balance-metric">
                        <span>COLA-adjusted Social Security income</span>
                        <strong>@FormatCurrency(firstPoint.AnnualSocialSecurityIncome)</strong>
                    </div>
                    <div class="balance-metric">
                        <span>Net withdrawal</span>
                        <strong>@FormatCurrency(firstPoint.NetWithdrawal)</strong>
                    </div>
                </div>

                <RetirementBalanceProjectionGraph
                    SelectedSeries="chosenBalance.ProjectionSeries"
                    FraSeries="fraBalance.ProjectionSeries"
                    SelectedSeriesLabel="Claim at chosen age"
                    FraSeriesLabel="Wait until FRA"
                    GraphTitle="Retirement account balance"
                    GraphDescription="Ages and account balances for the chosen claim age and waiting until full retirement age, with Social Security offsets include modeled COLA." />
            </div>
        }
    </section>
}

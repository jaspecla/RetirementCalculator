@namespace RetirementCalculator.Web.Components
@using System.Globalization
@using RetirementCalculator.Domain.Models
@{
    var selectedSeries = SelectedSeries?.ToArray() ?? Array.Empty<RetirementBalanceProjectionPoint>();
    var fraSeries = FraSeries?.ToArray() ?? Array.Empty<RetirementBalanceProjectionPoint>();
    var allPoints = selectedSeries.Concat(fraSeries).ToArray();
    var minAge = allPoints.Length > 0 ? allPoints.Min(point => point.Age.TotalMonths) : 0;
    var maxAge = allPoints.Length > 0 ? allPoints.Max(point => point.Age.TotalMonths) : 0;
    var minValue = allPoints.Length > 0 ? Math.Min(0m, allPoints.Min(point => point.EndingBalance)) : 0m;
    var maxValue = allPoints.Length > 0 ? Math.Max(0m, allPoints.Max(point => point.EndingBalance)) : 0m;
    var ageTicks = GetAgeTicks(minAge, maxAge);
    var valueTicks = GetValueTicks(minValue, maxValue);
    var description = GetEffectiveGraphDescription(minAge, maxAge, selectedSeries, fraSeries);
    var isCoincident = selectedSeries.SequenceEqual(fraSeries);
    var selectedPolyline = BuildPolyline(selectedSeries, minAge, maxAge, minValue, maxValue);
    var fraPolyline = BuildPolyline(fraSeries, minAge, maxAge, minValue, maxValue);
    var selectedMarker = GetDepletionMarker(selectedSeries, minAge, maxAge, minValue, maxValue);
    var fraMarker = GetDepletionMarker(fraSeries, minAge, maxAge, minValue, maxValue);
}

<figure class="retirement-balance-figure">
    <svg class="retirement-balance-graph"
         role="img"
         aria-label="@GraphTitle"
         viewBox="0 0 640 300"
         preserveAspectRatio="xMidYMid meet"
         aria-labelledby="@($"{TitleId} {DescId}")">
        <title id="@TitleId">@GraphTitle</title>
        <desc id="@DescId">@description</desc>

        <line class="axis-line" x1="@ChartLeft" y1="@ChartBottom" x2="@ChartRight" y2="@ChartBottom" />
        <line class="axis-line" x1="@ChartLeft" y1="@ChartTop" x2="@ChartLeft" y2="@ChartBottom" />

        @foreach (var tick in ageTicks)
        {
            var x = MapXAxisPosition(tick * 12, minAge, maxAge);
            <g class="axis-tick age-tick">
                <line class="tick-line" x1="@x" y1="@ChartBottom" x2="@x" y2="@(ChartBottom + 6)" />
                <text class="axis-tick-label age-tick-label" x="@x" y="@(ChartBottom + 18)" text-anchor="middle">@FormatAgeLabel(tick)</text>
            </g>
        }

        @foreach (var tick in valueTicks)
        {
            var y = MapYAxisPosition(tick, minValue, maxValue);
            <g class="axis-tick value-tick">
                <line class="tick-line" x1="@(ChartLeft - 6)" y1="@y" x2="@ChartLeft" y2="@y" />
                <text class="axis-tick-label value-tick-label" x="@(ChartLeft - 10)" y="@(y + 4)" text-anchor="end">@FormatCurrency(tick)</text>
            </g>
        }

        <text class="axis-title x-axis-title" x="@(ChartLeft + ChartWidth / 2.0)" y="286" text-anchor="middle">Age</text>
        <text class="axis-title y-axis-title" x="20" y="@(ChartTop + ChartHeight / 2.0)" text-anchor="middle" transform="rotate(-90 20 @(ChartTop + ChartHeight / 2.0))">Account balance</text>

        <polyline class="retirement-balance-series selected-series" points="@selectedPolyline" stroke-dasharray="@GetDashPattern(isCoincident, isSelected: true)" />
        <polyline class="retirement-balance-series fra-series" points="@fraPolyline" stroke-dasharray="@GetDashPattern(isCoincident, isSelected: false)" />

        @if (selectedMarker is DepletionMarker selectedDepletionMarker)
        {
            <g class="depletion-marker selected-depletion-marker" aria-label="@GetMarkerAriaLabel(SelectedSeriesLabel, selectedDepletionMarker.Age)">
                <circle class="depletion-dot selected-dot" cx="@selectedDepletionMarker.X" cy="@selectedDepletionMarker.Y" r="5" />
                <text class="depletion-label selected-label" x="@selectedDepletionMarker.LabelX" y="@selectedDepletionMarker.LabelY" text-anchor="start">@FormatMarkerLabel(selectedDepletionMarker.Age)</text>
            </g>
        }

        @if (fraMarker is DepletionMarker fraDepletionMarker)
        {
            <g class="depletion-marker fra-depletion-marker" aria-label="@GetMarkerAriaLabel(FraSeriesLabel, fraDepletionMarker.Age)">
                <circle class="depletion-dot fra-dot" cx="@fraDepletionMarker.X" cy="@fraDepletionMarker.Y" r="5" />
                <text class="depletion-label fra-label" x="@fraDepletionMarker.LabelX" y="@fraDepletionMarker.LabelY" text-anchor="start">@FormatMarkerLabel(fraDepletionMarker.Age)</text>
            </g>
        }
    </svg>

    <div class="retirement-balance-legend" aria-label="Scenario legend">
        <div class="legend-item">
            <span class="legend-swatch selected-swatch" aria-hidden="true"></span>
            <span>@SelectedSeriesLabel</span>
        </div>
        <div class="legend-item">
            <span class="legend-swatch fra-swatch" aria-hidden="true"></span>
            <span>@FraSeriesLabel</span>
        </div>
    </div>
</figure>

@code {
    [Parameter]
    public IReadOnlyList<RetirementBalanceProjectionPoint> SelectedSeries { get; set; } = Array.Empty<RetirementBalanceProjectionPoint>();

    [Parameter]
    public IReadOnlyList<RetirementBalanceProjectionPoint> FraSeries { get; set; } = Array.Empty<RetirementBalanceProjectionPoint>();

    [Parameter]
    public string SelectedSeriesLabel { get; set; } = "Chosen claim age";

    [Parameter]
    public string FraSeriesLabel { get; set; } = "Full retirement age";

    [Parameter]
    public string GraphTitle { get; set; } = "Retirement account balance";

    [Parameter]
    public string GraphDescription { get; set; } = string.Empty;

    private const int ChartLeft = 70;
    private const int ChartTop = 30;
    private const int ChartRight = 610;
    private const int ChartBottom = 250;
    private const int ChartWidth = ChartRight - ChartLeft;
    private const int ChartHeight = ChartBottom - ChartTop;

    private string TitleId => Slugify(SelectedSeriesLabel) + "-" + Slugify(FraSeriesLabel) + "-title";

    private string DescId => Slugify(SelectedSeriesLabel) + "-" + Slugify(FraSeriesLabel) + "-desc";

    private string GetEffectiveGraphDescription(int minAge, int maxAge, IReadOnlyList<RetirementBalanceProjectionPoint> selectedSeries, IReadOnlyList<RetirementBalanceProjectionPoint> fraSeries)
    {
        if (!string.IsNullOrWhiteSpace(GraphDescription))
        {
            return GraphDescription;
        }

        if (selectedSeries.Count == 0 && fraSeries.Count == 0)
        {
            return "No retirement account balance data is available for this comparison.";
        }

        var selectedLabel = string.IsNullOrWhiteSpace(SelectedSeriesLabel) ? "Chosen claim age" : SelectedSeriesLabel;
        var fraLabel = string.IsNullOrWhiteSpace(FraSeriesLabel) ? "Full retirement age" : FraSeriesLabel;
        var firstAge = Math.Max(minAge, 0);
        var lastAge = Math.Max(maxAge, firstAge);
        var firstAgeDisplay = (int)Math.Floor(firstAge / 12d);
        var lastAgeDisplay = (int)Math.Floor(lastAge / 12d);
        var selectedStatus = GetSeriesDescription(selectedSeries, selectedLabel);
        var fraStatus = GetSeriesDescription(fraSeries, fraLabel);

        return $"Ages {FormatAgeLabel(firstAgeDisplay)} to {FormatAgeLabel(lastAgeDisplay)}. {selectedStatus} {fraStatus} Social Security offsets include modeled COLA.";
    }

    private static string GetSeriesDescription(IReadOnlyList<RetirementBalanceProjectionPoint> series, string label)
    {
        if (series.Count == 0)
        {
            return $"{label} has no data.";
        }

        foreach (var point in series)
        {
            if (point.EndingBalance == 0m)
            {
                return $"{label} reaches zero balance at age {FormatAgeDescription(point.Age)}.";
            }
        }

        return $"{label} remains above zero throughout the displayed range.";
    }

    private static IReadOnlyList<int> GetAgeTicks(int minAge, int maxAge)
    {
        if (maxAge <= minAge)
        {
            var singleAge = (int)Math.Floor(minAge / 12d);
            return singleAge > 0 ? new[] { singleAge } : new[] { 0 };
        }

        var minimumAge = (int)Math.Floor(minAge / 12d);
        var maximumAge = (int)Math.Floor(maxAge / 12d);
        var ageRange = Math.Max(maximumAge - minimumAge, 1);
        var tickCount = Math.Min(5, Math.Max(2, ageRange + 1));
        var ticks = new List<int>();

        for (var index = 0; index < tickCount; index++)
        {
            var value = minimumAge + (int)Math.Round((ageRange * (double)index) / (tickCount - 1));
            if (index == 0)
            {
                value = minimumAge;
            }
            else if (index == tickCount - 1)
            {
                value = maximumAge;
            }

            if (value < minimumAge)
            {
                value = minimumAge;
            }

            if (value > maximumAge)
            {
                value = maximumAge;
            }

            ticks.Add(value);
        }

        return ticks.Distinct().ToArray();
    }

    private static IReadOnlyList<decimal> GetValueTicks(decimal minValue, decimal maxValue)
    {
        if (maxValue <= minValue)
        {
            return new[] { minValue };
        }

        var ticks = new List<decimal>();
        for (var index = 0; index <= 4; index++)
        {
            ticks.Add(minValue + ((maxValue - minValue) * index / 4m));
        }

        return ticks;
    }

    private static string BuildPolyline(IReadOnlyList<RetirementBalanceProjectionPoint> series, int minAge, int maxAge, decimal minValue, decimal maxValue)
    {
        if (series.Count == 0)
        {
            return string.Empty;
        }

        var points = new List<string>(series.Count);

        foreach (var point in series)
        {
            var scaledX = MapXAxisPosition(point.Age.TotalMonths, minAge, maxAge);
            var scaledY = MapYAxisPosition(point.EndingBalance, minValue, maxValue);
            points.Add(FormatChartPoint(scaledX, scaledY));
        }

        return string.Join(" ", points);
    }

    private static DepletionMarker? GetDepletionMarker(IReadOnlyList<RetirementBalanceProjectionPoint> series, int minAge, int maxAge, decimal minValue, decimal maxValue)
    {
        foreach (var point in series)
        {
            if (point.EndingBalance == 0m)
            {
                var x = MapXAxisPosition(point.Age.TotalMonths, minAge, maxAge);
                var y = MapYAxisPosition(0m, minValue, maxValue);
                var labelX = x + 8;
                var labelY = y - 12;
                return new DepletionMarker(x, y, labelX, labelY, point.Age);
            }
        }

        return null;
    }

    private static string GetMarkerAriaLabel(string label, Age age)
    {
        return $"{label} reaches zero balance at age {FormatAgeDescription(age)}.";
    }

    private static string FormatMarkerLabel(Age age)
    {
        return age.Months == 0 ? $"Age {age.TotalYears}" : $"Age {age.TotalYears} yr {age.Months} mo";
    }

    private static string FormatAgeDescription(Age age)
    {
        return age.Months == 0 ? $"{age.TotalYears}" : $"{age.TotalYears} yr {age.Months} mo";
    }

    private static double MapXAxisPosition(int ageInMonths, int minAge, int maxAge)
    {
        if (maxAge <= minAge)
        {
            return ChartLeft + ChartWidth / 2d;
        }

        var ageRange = Math.Max(maxAge - minAge, 1);
        return ChartLeft + ((ageInMonths - minAge) / (double)ageRange) * ChartWidth;
    }

    private static double MapYAxisPosition(decimal value, decimal minValue, decimal maxValue)
    {
        if (maxValue <= minValue)
        {
            return ChartBottom;
        }

        var valueRange = maxValue - minValue;
        return ChartBottom - ((double)((value - minValue) / valueRange) * ChartHeight);
    }

    private static string FormatChartPoint(double x, double y)
    {
        var xLabel = x.ToString("0.##", CultureInfo.InvariantCulture);
        var yLabel = y.ToString("0.##", CultureInfo.InvariantCulture);
        return $"{xLabel},{yLabel}";
    }

    private static string FormatAgeLabel(int ageInYears)
    {
        return ageInYears.ToString(CultureInfo.InvariantCulture);
    }

    private static string FormatCurrency(decimal value) => value.ToString("C0", CultureInfo.GetCultureInfo("en-US"));

    private static string GetDashPattern(bool isCoincident, bool isSelected) => isCoincident
        ? (isSelected ? "0" : "8 7")
        : "0";

    private static string Slugify(string value)
    {
        var normalized = new string(value
            .Trim()
            .Where(ch => char.IsLetterOrDigit(ch) || ch == '-')
            .ToArray())
            .Trim('-');

        return string.IsNullOrWhiteSpace(normalized) ? "graph" : normalized.ToLowerInvariant();
    }

    private readonly record struct DepletionMarker(double X, double Y, double LabelX, double LabelY, Age Age);
}
